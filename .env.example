# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kurta_kameez

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Sentry (optional)
SENTRY_DSN=

# Debug
DEBUG=true

# ── Email (Titan SMTP) ──────────────────────────────────────────
# order@ sends anything about an order, so replies land with the order.
# info@ sends password resets and contact enquiries. Separate mailboxes
# also mean separate daily send quotas.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_FROM_NAME=Wrenza

SMTP_ORDER_USER=order@example.com
SMTP_ORDER_PASSWORD=

SMTP_INFO_USER=info@example.com
SMTP_INFO_PASSWORD=

ADMIN_EMAIL=order@example.com
FRONTEND_URL=http://localhost:3001

# Logo at the top of every email. ImageKit resizes to 264px (2x, for retina)
# so a 1900px original is not sent to every recipient. Transparency is kept —
# the email card is white, so the logo sits on it naturally.
EMAIL_LOGO_URL=https://ik.imagekit.io/YOUR_ID/brand/logo.png?tr=w-264
EMAIL_LOGO_WIDTH=132

# ── Safepay payment gateway ─────────────────────────────────────
# Keys from the Safepay dashboard's Developer tab. SAFEPAY_ENVIRONMENT is
# "sandbox" or "production" — it picks both the API host and the hosted
# checkout page host, which differ (see app/services/safepay_service.py).
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENVIRONMENT=sandbox

# ── First admin user ────────────────────────────────────────────
# Created on container start if no admin exists yet. Deliberately NOT
# ADMIN_EMAIL — that one is where new-order alerts go, and reusing it would
# create a dashboard login for order@wrenza.com.
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=change-me-before-deploying
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
